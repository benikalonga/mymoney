NODE_ENV=development
PORT=4100
DATABASE_PATH=./data/mymoney.db
# Required in production, at least 32 characters.
JWT_SECRET=YOUR_SECRETS
# Comma-separated list of allowed browser origins (the console).
CORS_ORIGINS=http://localhost:3100
# sandbox settles top-ups and payouts automatically. live waits for signed provider webhooks.
PROVIDER_MODE=sandbox
SANDBOX_SETTLE_SECONDS=4
PROVIDER_WEBHOOK_SECRET=YOUR_SECRETS
# The demo customer the seed creates. Replace both before running npm run db:seed.
DEMO_PHONE=YOUR_PHONE_NUMBER
DEMO_PIN=YOUR_PIN
